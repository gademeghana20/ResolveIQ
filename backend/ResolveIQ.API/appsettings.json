{
  "ConnectionStrings": {
  "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ResolveIQDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ResolveIQ.API",
    "Audience": "ResolveIQ.Client",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Registration": {
    "Enabled": true,
    "AllowedEmailDomains": []
  },
  "RateLimiting": {
    "AuthPermitLimit": 20,
    "GeneralPermitLimit": 600
  },
  "Maintenance": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "AutoCloseResolvedAfterDays": 7
  },
  "App": {
    "FrontendUrl": "http://localhost:4200"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
